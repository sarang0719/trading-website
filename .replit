run = "npm run build && npm start"
entrypoint = "server/index.ts"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run build && npm start"]
deploymentTarget = "cloudrun"

[env]
PORT = "3000"
NODE_ENV = "production"

[[ports]]
localPort = 3000
externalPort = 80
